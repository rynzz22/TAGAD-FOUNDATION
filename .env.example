# ==============================================================================
# TAGAD SYSTEM — ENVIRONMENT CONFIGURATION
# Municipality of Talibon, Bohol — Gender and Development Analytics Platform
# ==============================================================================

# Application Metadata
VITE_APP_NAME="TAGAD"
VITE_MUNICIPALITY="Talibon, Bohol"

# Supabase Platform Configuration (Frontend / Browser Client)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Database Connections (PostgreSQL Pooled & Direct)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Server-side Administration (Never expose to frontend client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Development JWT Secret (for local fallback)
JWT_SECRET="tagad_talibon_secret_2025"
